person "==Apicultrice\n<size:16>[Person]</size>\n\nInspecte les ruches sur le terrain, même hors ligne." <<Element-RWxlbWVudCxQZXJzb24=>> as Apicultrice
person "==Vétérinaire apicole\n<size:16>[Person]</size>\n\nSurveille la santé des colonies et analyse les alertes sanitaires." <<Element-RWxlbWVudCxQZXJzb24=>> as Vétérinaireapicole
person "==Coordinateur régional\n<size:16>[Person]</size>\n\nPlanifie les tournées et gère la logistique des ruchers." <<Element-RWxlbWVudCxQZXJzb24=>> as Coordinateurrégional
person "==Responsable d'exploitation\n<size:16>[Person]</size>\n\nSupervise l'ensemble du parc, les comptes et les accès." <<Element-RWxlbWVudCxQZXJzb24=>> as Responsabledexploitation
rectangle "==Réseau de Capteurs IoT\n<size:16>[Software System]</size>\n\nCapteurs de température, humidité et pesée de ruche." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuZQ==>> as RéseaudeCapteursIoT
rectangle "==Fournisseur Météo\n<size:16>[Software System]</size>\n\nFournit les prévisions climatiques et alertes orages via API." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuZQ==>> as FournisseurMétéo
rectangle "==Passerelle SMS / Push\n<size:16>[Software System]</size>\n\nEnvoie les SMS d'urgence sanitaire aux techniciens." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuZQ==>> as PasserelleSMSPush
rectangle "==Fournisseur d'Identité OIDC\n<size:16>[Software System]</size>\n\nGestion centralisée des identités et authentification." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuZQ==>> as FournisseurdIdentitéOIDC

rectangle "QueenBee\n<size:16>[Software System]</size>" <<Boundary-UXVlZW5CZWU=>> {
  rectangle "==App Mobile Terrain\n<size:16>[Container: Flutter / SQLite]</size>\n\nSaisie des inspections hors-ligne et synchronisation." <<Element-RWxlbWVudCxDb250YWluZXI=>> as QueenBee.AppMobileTerrain
  rectangle "==Portail Web Métier\n<size:16>[Container: React / TypeScript]</size>\n\nInterface de supervision, planification et analytics." <<Element-RWxlbWVudCxDb250YWluZXI=>> as QueenBee.PortailWebMétier
  rectangle "==API Centrale\n<size:16>[Container: Node.js 22 / Fastify]</size>\n\nCœur métier et règles applicatives." <<Element-RWxlbWVudCxDb250YWluZXI=>> as QueenBee.APICentrale
  database "==Base de Données Centrale\n<size:16>[Container: PostgreSQL 16]</size>\n\nStockage transactionnel principal (ruchers, inspections)." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as QueenBee.BasedeDonnéesCentrale
  rectangle "==Message Broker\n<size:16>[Container: Mosquitto MQTT]</size>\n\nÉchange asynchrone des alertes et des mesures terrain." <<Element-RWxlbWVudCxDb250YWluZXI=>> as QueenBee.MessageBroker
  rectangle "==Passerelle de Site (Edge)\n<size:16>[Container: Go / SQLite local]</size>\n\nCollecte locale LoRaWAN, cache et téléversement." <<Element-RWxlbWVudCxDb250YWluZXI=>> as QueenBee.PasserelledeSiteEdge
  rectangle "==Moteur d'Escalade\n<size:16>[Container: Node.js Worker]</size>\n\nDéclenchement des alertes et escalades à 48h." <<Element-RWxlbWVudCxDb250YWluZXI=>> as QueenBee.MoteurdEscalade
  database "==Stockage d'Objets\n<size:16>[Container: MinIO / S3]</size>\n\nStockage sécurisé des photos de cadres et rapports." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as QueenBee.StockagedObjets
}

